{
  "name": "argon-bridge",
  "version": "1.0.0",
  "description": "Local, modular, and privacy-first bridge between Gemini Web and Google Antigravity via MCP and Chrome Native Messaging",
  "author": "DarwinSin",
  "license": "MIT",
  "type": "module",
  "bin": {
    "argon-mcp": "./dist/mcp/server.js",
    "argon-native-host": "./dist/native-host/host.js",
    "argon-cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node scripts/demo.js",
    "start:mcp": "node dist/mcp/server.js",
    "start:host": "node dist/native-host/host.js",
    "doctor": "bash scripts/doctor.sh",
    "install:linux": "bash scripts/install-linux.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
